{
  "license": "GPL-3.0-or-later",
  "type": "stills",
  "runtime": "docker",
  "label": "Images fixes",
  "badge": {
    "label": "Stills",
    "class": "mode-media",
    "oklch": "0.78 0.04 230"
  },
  "version": "0.6.0",
  "description": "Affiche une image fixe (avec transparence) et la produit dans le pipeline MXL (flux planar natifs via bobimxl) : sortie Fill + sortie Key (alpha).",
  "nav": {
    "section": "medias",
    "label": "Medias",
    "route": "/medias",
    "order": 15
  },
  "script_template": "script.py",
  "ui": {
    "control_html": "control.html",
    "control_js": "control.js",
    "control_css": "control.css"
  },
  "deploy_defaults": {
    "folder": "",
    "file": "",
    "fit": "native",
    "x": 0,
    "y": 0,
    "size": 100,
    "width": 1280,
    "height": 720,
    "fps": 25,
    "media_root": "/mnt/media",
    "genlock": true
  },
  "media_volume": true,
  "wiring": {
    "produces": [
      {
        "essence": "video",
        "shm": "{hostname}"
      },
      {
        "essence": "video",
        "shm": "{hostname}_key"
      }
    ],
    "consumes": [],
    "mode": "redeploy"
  },
  "control": {
    "endpoints": [
      "/state",
      "/folders",
      "/images",
      "/thumb",
      "/select"
    ]
  }
}
